# Database Connection (Supabase Transaction Pooler URL recommended for serverless/hosted Express servers)
DATABASE_URL=postgres://postgres.[your-project-ref]:[your-database-password]@aws-0-[your-region].pooler.supabase.com:6543/postgres?pgbouncer=true

# Authentication / Session
JWT_SECRET=your_jwt_secret_key
OWNER_OPEN_ID=your_owner_openid

# Forge Storage configuration (provided by environment)
BUILT_IN_FORGE_API_URL=http://localhost:3000
BUILT_IN_FORGE_API_KEY=local-dev-key

# Client OAuth / App Settings
VITE_APP_ID=certificate-bulk-sender
VITE_OAUTH_PORTAL_URL=http://localhost:3000
PORT=3000
